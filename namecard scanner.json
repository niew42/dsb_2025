    {
      "parameters": {
        "jsCode": "// --- Setup: รับข้อมูลจาก Input ทั้งสอง ---\nconst aiItems = $input.all(0);\nconst triggerItems = $input.all(1);\n\n// --- 1. รับและทำความสะอาดข้อมูลจาก AI Agent ---\nconst cleanedString = aiItems[0].json.output\n  .replace(/```json\\n/g, \"\")\n  .replace(/\\n```/g, \"\");\n\n// --- 2. แปลงเป็น JSON Object ---\nlet jsonObject;\ntry {\n  jsonObject = JSON.parse(cleanedString);\n} catch (error) {\n  return [{ json: { error: \"Failed to parse JSON\" } }];\n}\n\n// --- 3. ดึงและสกัด Remark จาก Telegram Trigger (เวอร์ชันปรับปรุง) ---\nlet remark = \"-\"; \nconst caption = triggerItems[0].json.message?.caption; \n\nif (caption && caption.startsWith(\"rm \")) {\n  // ตัดเอาข้อความหลัง \"rm \" และลบช่องว่างหน้า-หลัง\n  const fullRemark = caption.substring(3).trim(); \n  // แยกข้อความด้วยช่องว่าง แล้วเอามาแค่ส่วนแรก\n  remark = fullRemark.split(' ')[0]; \n}\n\n// --- 4. เพิ่ม Remark เข้าไปใน Object ข้อมูล ---\njsonObject.remark = remark;\n\n// --- 5. วนลูปเช็คค่าว่างและจัดรูปแบบข้อมูล ---\nfor (const key in jsonObject) {\n  if (jsonObject[key] === null || jsonObject[key] === undefined || jsonObject[key] === \"\") {\n    jsonObject[key] = \"-\";\n  }\n}\n\n// --- 6. จัดการเบอร์โทรศัพท์เป็นพิเศษ ---\nif (jsonObject.phonenumber && jsonObject.phonenumber !== \"-\") {\n  jsonObject.phonenumber = \"'\" + jsonObject.phonenumber;\n}\n\n// --- 7. ส่งผลลัพธ์ที่สมบูรณ์ออกไป ---\nreturn [jsonObject];"
      },
